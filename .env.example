# Cloudflare R2 (S3-compatible) credentials
R2_ENDPOINT_URL=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: default bucket prefix for voices (fallback to voices.yaml if set there)
R2_PREFIX=

# API v2 bind config (used by deploy/start_api.sh defaults)
API_HOST=127.0.0.1
API_PORT=9880

